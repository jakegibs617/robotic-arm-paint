   "record": {
    "answered_ids": [
     1
    ],
    "model_number": 777,
    "firmware": "3.10",
    "voltage_v": 4.3,
    "temperature_c": 26,
    "position_counts": 4093,
    "angle_limits_counts": [
     0,
     4095
    ],
    "error_flags": 0,
    "adapter_echo_observed": false,
    "notes": "Measured 2026-09-26 on USB power only. Model 777 = MODEL_L 9 + MODEL_H 3*256, confirming STS3215. Read path (PING, register reads, framing, checksums, little-endian decode) verified against real hardware for the first time. Full read-only register dump also showed: torque off at rest, a STALE Goal_Position of 0 while sitting at 4094 counts (enabling torque in that state would command a near-full-turn slam -- motion_probe now overwrites the goal with the current position before energising), and Response Status Level 1 (the servo acks every write). Measured directly: a Goal_Position write that DIFFERS from the present position implicitly enables torque (0 -> 1), while a write equal to the present position does not. A goal write is the act of energising; nothing can pre-stage a goal without committing to motion.",
    "torque_enable_at_rest": 0,
    "goal_position_at_rest": 0,
    "response_status_level": 1,
    "operating_mode": 0,
    "voltage_protection_window_v": [
     4.0,
     8.0
    ],
    "temperature_limit_c": 70,
    "max_torque_limit": 1000,
    "goal_write_implicitly_enables_torque": true
   }
