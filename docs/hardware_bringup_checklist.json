   "id": "HW-SCAN-001",
   "title": "Scan the bus and identify every servo that answers",
   "status": "done",
   "hardware_required": true,
   "category": "discovery",
   "source": "docs/hardware_identification.md#bring-up-checklist-do-in-order-one-servo-at-a-time",
   "expected": {
    "command": "bringup --port <dev> --protocol sts3215 --baud 1000000 scan --ids 0-11",
    "factory_id": 1,
    "factory_baud": 1000000,
    "model_number": 777,
    "adapter_echo_expected": false
